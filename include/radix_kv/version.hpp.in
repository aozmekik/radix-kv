#pragma once

/// @file
/// Library version, generated by CMake from `project(VERSION)`.

#include <string_view>

// Macros so that consumers can test the version in #if.
// NOLINTBEGIN(cppcoreguidelines-macro-usage,cppcoreguidelines-macro-to-enum,modernize-macro-to-enum)
/// Major version.
#define RADIX_KV_VERSION_MAJOR @PROJECT_VERSION_MAJOR @
/// Minor version.
#define RADIX_KV_VERSION_MINOR @PROJECT_VERSION_MINOR @
/// Patch version.
#define RADIX_KV_VERSION_PATCH @PROJECT_VERSION_PATCH @
// NOLINTEND(cppcoreguidelines-macro-usage,cppcoreguidelines-macro-to-enum,modernize-macro-to-enum)

namespace radix_kv {

/// The library version as `"MAJOR.MINOR.PATCH"`.
inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

}  // namespace radix_kv
